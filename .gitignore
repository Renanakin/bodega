apps/api/*.sqlite3
# Permitir explicitamente scripts utiles (no son runtime)
!apps/api/data/db_schema_inspect.py

# Auditoria local de fase 0 (snapshots de secretos quemados)
auditoria-fase0/
# Auditoria local de fase 5 (smoke test scripts, logs)
auditoria-fase5/

# SSL/TLS artifacts (generados, no commitear)
infra/docker/nginx/ssl/
infra/docker/nginx/dhparam.pem
*.crt
*.key

# Test logs (temporales, regenerables)
tests/e2e/_run_*.log
tests/e2e/_preprod_check.log
