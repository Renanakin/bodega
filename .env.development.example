# =============================================================================
# Environment: DEVELOPMENT (Regla de Oro R2)
# =============================================================================
# Este archivo se carga cuando ENVIRONMENT=development.
# Valores solo para desarrollo local. NUNCA usar en staging/production.

ENVIRONMENT=development
DEBUG=true
APP_NAME=Bodegaje API (dev)
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# --- Database (Postgres local vía docker-compose) ---
DATABASE_URL=postgresql+asyncpg://bodegaje:bodegaje@localhost:5432/bodegaje
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=true

# --- Redis local ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (R1: secret dummy, solo dev) ---
JWT_SECRET=dev-secret-not-for-production-32chars-XXXXXX
JWT_ALGORITHM=HS256
SESSION_DURATION_HOURS=24
PASSWORD_HASH_ITERATIONS=600000

# --- SMTP (Mailpit local - ADR-0005) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@bodega.example
SMTP_USE_TLS=false

# --- Observability (R8) ---
LOG_LEVEL=DEBUG
SENTRY_DSN=
METRICS_ENABLED=true

# --- CORS (dev: localhost) ---
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1,http://localhost

# --- Approval tokens (ADR-0006) ---
APPROVAL_TOKEN_MAX_AGE_DAYS=7

# --- Workers (ADR-0004) ---
WORKER_CONCURRENCY=2
WORKER_MAX_JOBS=5
REPLENISHMENT_EVAL_INTERVAL_SECONDS=300
