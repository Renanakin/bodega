# =============================================================================
# Environment: PRODUCTION (Regla de Oro R2)
# =============================================================================
# Cargado cuando ENVIRONMENT=production.
# IMPORTANTE: este archivo .env.production NUNCA debe commitearse.
# En producción real, los secretos se leen de:
#   - GitHub Secrets (durante CI/CD)
#   - AWS Secrets Manager / Vault (en runtime)
# Este archivo es SOLO plantilla.

ENVIRONMENT=production
DEBUG=false
APP_NAME=Bodegaje API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# --- Database (RDS o equivalente administrado) ---
DATABASE_URL=postgresql+asyncpg://bodegaje_prod:CHANGE_ME_VIA_SECRETS_MANAGER@db-prod.internal:5432/bodegaje_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_ECHO=false

# --- Redis (ElastiCache o equivalente) ---
REDIS_URL=redis://redis-prod.internal:6379/0

# --- Auth (R1: secret único production, rotación anual) ---
# Generar con: python infra/scripts/generate-secrets.py --print-only
# En produccion real, sobreescribir via AWS Secrets Manager / Vault.
# DEBE ser distinto de SECRET_KEY y de cualquier otro entorno (dev/staging).
JWT_SECRET=__GENERAR_CON_python_secrets_token_urlsafe_32__
JWT_ALGORITHM=HS256
SESSION_DURATION_HOURS=8
PASSWORD_HASH_ITERATIONS=600000
# Generar con el mismo script. DEBE ser distinto de JWT_SECRET (defense in depth).
SECRET_KEY=__GENERAR_CON_python_secrets_token_urlsafe_32_OTRO__

# --- SMTP AWS SES (ADR-0005) ---
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SES_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SES_SMTP_PASSWORD
SMTP_FROM=noreply@bodega.example
SMTP_USE_TLS=true

# --- Observability ---
LOG_LEVEL=WARNING
SENTRY_DSN=https://CHANGE_ME@sentry.io/PROJECT_ID
METRICS_ENABLED=true

# --- CORS production ---
CORS_ALLOWED_ORIGINS=https://app.bodega.example,https://admin.bodega.example

# --- Approval tokens ---
APPROVAL_TOKEN_MAX_AGE_DAYS=7

# --- Workers ---
WORKER_CONCURRENCY=8
WORKER_MAX_JOBS=20
REPLENISHMENT_EVAL_INTERVAL_SECONDS=300
