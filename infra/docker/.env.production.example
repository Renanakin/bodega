# =============================================================================
# .env.production.example - Plantilla de variables de entorno para PRODUCCION
# =============================================================================
# F2 del roadmap 100% produccion (docs/roadmap_100_por_ciento.md).
#
# INSTRUCCIONES:
# 1. Generar secrets con: python infra/scripts/generate-secrets.py --print-only
# 2. Copiar este archivo a .env.production
# 3. Reemplazar todos los CHANGEME con los valores generados
# 4. MONTAR en docker compose via `env_file: .env.production`
#    O usar un secrets manager (Vault, AWS SM) y leer via
#    `docker secret` o similar.
#
# NUNCA commitear el .env.production real con secrets al repo.
# NUNCA usar los valores de dev (cambiar TODOS los passwords al migrar).
#
# Rotacion:
# - Cada 90 dias para passwords de BD
# - Cada 30 dias para JWT_SECRET
# - Cada 7 dias para SMTP_PASSWORD (si es critical)
# =============================================================================

# -----------------------------------------------------------------------------
# Entorno
# -----------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=America/Santiago

# -----------------------------------------------------------------------------
# Base de datos (Postgres 17)
# -----------------------------------------------------------------------------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=bodegaje_prod
POSTGRES_PASSWORD=CHANGEME_use_generate_secrets_32chars_min
POSTGRES_DB=bodegaje_prod
DATABASE_URL=postgresql+asyncpg://bodegaje_prod:CHANGEME@db:5432/bodegaje_prod

# Pool de conexiones (ajustar segun carga).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# -----------------------------------------------------------------------------
# Redis (cache, rate limit, sesiones)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=CHANGEME_use_generate_secrets_32chars_min

# -----------------------------------------------------------------------------
# JWT y autenticacion (C5.1)
# -----------------------------------------------------------------------------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGEME_use_generate_secrets_64chars_min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# -----------------------------------------------------------------------------
# SMTP (Fase 7, ADR-0004)
# -----------------------------------------------------------------------------
# En produccion real NO usar Mailpit. Usar SES, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=CHANGEME_smtp_api_key
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@bodega.cl
SMTP_FROM_NAME=Bodegaje

# Email outbox (P2 del roadmap Big-O)
EMAIL_OUTBOX_MAX_CONCURRENT=10
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_SECONDS=30,300,1800

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Lista separada por comas de origenes permitidos.
CORS_ALLOWED_ORIGINS=https://bodega.cl,https://app.bodega.cl
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# HTTPS / TLS
# -----------------------------------------------------------------------------
# En produccion: cert de Let's Encrypt o ACM. NO usar cert self-signed.
TLS_CERT_PATH=/etc/nginx/ssl/server.crt
TLS_KEY_PATH=/etc/nginx/ssl/server.key
TLS_DHPARAM_PATH=/etc/nginx/dhparam.pem

# -----------------------------------------------------------------------------
# Rate limiting (C5.2)
# -----------------------------------------------------------------------------
# Ya implementado en la app. Estos son los valores por defecto.
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=10
RATE_LIMIT_PUBLIC_OC_PER_MINUTE=5
RATE_LIMIT_GENERAL_PER_MINUTE=100

# -----------------------------------------------------------------------------
# Monitoring y observabilidad
# -----------------------------------------------------------------------------
# Sentry para tracking de errores.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus + Grafana (ya configurados en docker-compose).
METRICS_ENABLED=true
METRICS_PATH=/metrics

# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------
BACKUP_SCHEDULE=0 3 * * *      # 03:00 UTC diario
BACKUP_RETENTION_DAYS=7
BACKUP_OFFSITE_BUCKET=s3://bodegaje-prod-backups
BACKUP_OFFSITE_REGION=us-east-1
BACKUP_AWS_ACCESS_KEY_ID=CHANGEME
BACKUP_AWS_SECRET_ACCESS_KEY=CHANGEME

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
# Permite desactivar features problematicos sin redeploy.
FEATURE_EMAIL_OUTBOX_ENABLED=true
FEATURE_REPLENISHMENT_AUTO_ENABLED=true
FEATURE_OC_EMAIL_ENABLED=true

# -----------------------------------------------------------------------------
# Logging estructurado
# -----------------------------------------------------------------------------
LOG_FORMAT=json
LOG_CORRELATION_ID_HEADER=X-Correlation-ID
LOG_RETENTION_DAYS=90

# =============================================================================
# FIN del template. Recordar:
# 1. Reemplazar TODOS los CHANGEME
# 2. NUNCA commitear este archivo con valores reales
# 3. Rotar secrets cada 30-90 dias segun criticidad
# 4. Auditar accesos a secrets via cloud provider
# =============================================================================
