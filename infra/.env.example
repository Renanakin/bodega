# =============================================================================
# .env.example — Bodegaje (Fase 10: Hardening de Produccion)
# =============================================================================
# Plantilla de variables de entorno para DESARROLLO LOCAL.
# Copia este archivo a `.env.development` (o `.env` en la raiz del repo) y
# rellena los placeholders.
#
# CONVENCIONES:
# - Los valores con prefijo `__` son placeholders a reemplazar.
# - NO commitees archivos `.env.development` / `.env.staging` / `.env.production`
#   al repo (estan en .gitignore).
# - Para generar secretos seguros:
#     python infra/scripts/generate-secrets.py
# =============================================================================


# -----------------------------------------------------------------------------
# Application (R1, R2)
# -----------------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
APP_PORT=80
API_PORT=8000
WEB_PORT=5173

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=bodegaje
POSTGRES_USER=bodegaje
POSTGRES_PASSWORD=__CAMBIAR_EN_DESARROLLO__
POSTGRES_PORT=5432
# URL completa para SQLAlchemy async (ADR-0001). El hostname `db` es el
# nombre del servicio en docker-compose; NO usar localhost entre containers.
DATABASE_URL=postgresql+asyncpg://bodegaje:__PASSWORD__@db:5432/bodegaje

# -----------------------------------------------------------------------------
# Redis (cache + cola Arq - ADR-0004)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# JWT (sesiones HTTP)
# Minimo 32 caracteres. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# -----------------------------------------------------------------------------
JWT_SECRET=__GENERAR_CON_python_secrets_token_urlsafe_32__
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_DURATION_HOURS=12

# -----------------------------------------------------------------------------
# Secret dedicado para Approval Tokens OC (ADR-0005/0006, Fase 10)
# DEFENSE IN DEPTH: usa un secreto DISTINTO a JWT_SECRET.
# En produccion es OBLIGATORIO (model_validator lo exige).
# En dev/staging puede ser None (fallback a JWT_SECRET).
# -----------------------------------------------------------------------------
SECRET_KEY=__GENERAR_CON_python_secrets_token_urlsafe_32__
TOKEN_EXPIRATION_DAYS=7
APPROVAL_TOKEN_MAX_AGE_DAYS=7

# -----------------------------------------------------------------------------
# Password hashing (OWASP Password Storage Cheat Sheet 2023)
# Default 600_000 iteraciones PBKDF2-HMAC-SHA256.
# Solo modificar si sabes lo que haces.
# -----------------------------------------------------------------------------
PASSWORD_HASH_ITERATIONS=600000

# -----------------------------------------------------------------------------
# SMTP (Fase 7, ADR-0004)
# Dev: usar Mailpit (servicio `mailpit` del compose, sin TLS).
# Prod: SES/SendGrid/Mailgun con STARTTLS (SMTP_USE_TLS=true).
# -----------------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@bodegaje.example
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=30

# --- Email retry policy (Fase 7) ---
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_SECONDS=30,300,1800

# --- Public URLs (Fase 7) ---
# URL base donde la webapp esta expuesta. Se usa para construir
# approve_url / reject_url en el email de OC.
PUBLIC_BASE_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Observability (Fase 9)
# -----------------------------------------------------------------------------
# Sentry opcional. Vacio = desactivado. Si esta set, captura excepciones
# no manejadas con stacktrace + request context.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

LOG_LEVEL=DEBUG
LOG_FORMAT=console

# /metrics endpoint (Prometheus) - Fase 9
METRICS_ENABLED=true
METRICS_PATH=/metrics

# -----------------------------------------------------------------------------
# Rate limiting (Fase 6)
# -----------------------------------------------------------------------------
# Endpoints publicos de aprobacion OC (sin auth, validados por token HMAC).
RATE_LIMIT_PUBLIC_OC_PER_MINUTE=5
# Rate limit general por IP para el resto de la API.
RATE_LIMIT_GENERAL_PER_MINUTE=100

# -----------------------------------------------------------------------------
# Backups (Fase 10)
# Usados por infra/scripts/backup-postgres.sh
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
# Opcional: bucket S3 donde subir backups off-site.
# Si esta vacio, el flag --upload-s3 es no-op.
BACKUP_S3_BUCKET=

# -----------------------------------------------------------------------------
# CORS (origenes permitidos para el frontend, CSV)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1,http://localhost
