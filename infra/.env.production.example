# =============================================================================
# .env.production.example — Bodegaje (Fase 10: Hardening de Produccion)
# =============================================================================
# Plantilla de variables de entorno para PRODUCCION.
# NUNCA commitees el archivo real `.env.production` con valores reales.
# Este template usa placeholders `__*__` para guiar la generacion.
#
# Para generar secretos:
#   python infra/scripts/generate-secrets.py --print-only
#
# En produccion se RECOMIENDA guardar este archivo en un vault:
#   - AWS Secrets Manager
#   - HashiCorp Vault
#   - Azure Key Vault
#   - O al menos un gestor de secretos con audit trail
# =============================================================================


# -----------------------------------------------------------------------------
# Application (R1, R2)
# -----------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_PORT=80
API_PORT=8000
WEB_PORT=5173
DOMAIN=__BODEDAJE_DNS__

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# IMPORTANTE: password FUERTE (32+ chars, alfanumerico + simbolos).
# Generar con: python infra/scripts/generate-secrets.py
# -----------------------------------------------------------------------------
POSTGRES_DB=bodegaje
POSTGRES_USER=bodegaje
POSTGRES_PASSWORD=__CAMBIAR_EN_PRODUCCION_PASSWORD_32CHARS__
POSTGRES_PORT=5432
# URL para SQLAlchemy async. Hostname `db` resuelve al servicio postgres
# dentro de la red de docker-compose. NUNCA usar localhost/127.0.0.1.
DATABASE_URL=postgresql+asyncpg://bodegaje:__PASSWORD__@db:5432/bodegaje

# -----------------------------------------------------------------------------
# Redis (cache + cola Arq - ADR-0004)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# JWT (sesiones HTTP) - 32+ caracteres, URL-safe
# -----------------------------------------------------------------------------
JWT_SECRET=__GENERAR_CON_python_secrets_token_urlsafe_32__
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_DURATION_HOURS=12

# -----------------------------------------------------------------------------
# Approval Tokens (ADR-0005/0006, Fase 10)
# OBLIGATORIO en produccion (model_validator lo exige).
# DEFENSE IN DEPTH: usar un secreto DISTINTO a JWT_SECRET.
# -----------------------------------------------------------------------------
SECRET_KEY=__GENERAR_CON_python_secrets_token_urlsafe_32_OTRO__
TOKEN_EXPIRATION_DAYS=7
APPROVAL_TOKEN_MAX_AGE_DAYS=7

# -----------------------------------------------------------------------------
# Password hashing
# -----------------------------------------------------------------------------
PASSWORD_HASH_ITERATIONS=600000

# -----------------------------------------------------------------------------
# SMTP - AWS SES / SendGrid / Mailgun con STARTTLS
# Obligatorio SMTP_USE_TLS=true en produccion (ADR-0004).
# -----------------------------------------------------------------------------
SMTP_HOST=__SES_SMTP_ENDPOINT__
SMTP_PORT=587
SMTP_USERNAME=__SES_SMTP_USER__
SMTP_PASSWORD=__SES_SMTP_PASSWORD__
SMTP_FROM=noreply@bodegaje.cl
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=30

# --- Email retry policy ---
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_SECONDS=30,300,1800

# --- Public URLs ---
PUBLIC_BASE_URL=https://__BODEDAJE_DNS__

# -----------------------------------------------------------------------------
# Observability (Fase 9)
# Sentry DSN (https://<key>@sentry.io/<project>). Opcional pero recomendado.
# -----------------------------------------------------------------------------
SENTRY_DSN=__SENTRY_DSN__
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

LOG_LEVEL=INFO
LOG_FORMAT=json

METRICS_ENABLED=true
METRICS_PATH=/metrics

# -----------------------------------------------------------------------------
# Rate limiting (Fase 6)
# -----------------------------------------------------------------------------
RATE_LIMIT_PUBLIC_OC_PER_MINUTE=5
RATE_LIMIT_GENERAL_PER_MINUTE=100

# -----------------------------------------------------------------------------
# Backups (Fase 10)
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
# Opcional: subir backups a S3 (recomendado para DR).
BACKUP_S3_BUCKET=__OPCIONAL_S3_BUCKET__

# -----------------------------------------------------------------------------
# CORS - solo el dominio publico de la webapp
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://__BODEDAJE_DNS__
