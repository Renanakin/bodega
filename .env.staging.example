# =============================================================================
# Environment: STAGING (Regla de Oro R2)
# =============================================================================
# Cargado cuando ENVIRONMENT=staging. Valores distintos de development y production.
# SMTP usa Mailgun sandbox (ADR-0005 decisión P2).

ENVIRONMENT=staging
DEBUG=false
APP_NAME=Bodegaje API (staging)
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# --- Database (RDS staging o instancia dedicada) ---
DATABASE_URL=postgresql+asyncpg://bodegaje_staging:CHANGE_ME@db-staging.internal:5432/bodegaje_staging
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis staging ---
REDIS_URL=redis://redis-staging.internal:6379/0

# --- Auth (R1: secret único staging) ---
JWT_SECRET=staging-secret-DIFFERENT-from-dev-and-prod-XXXX
JWT_ALGORITHM=HS256
SESSION_DURATION_HOURS=12
PASSWORD_HASH_ITERATIONS=600000

# --- SMTP Mailgun sandbox (ADR-0005) ---
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=postmaster@staging.bodega.example
SMTP_PASSWORD=CHANGE_ME_MAILGUN_SANDBOX_KEY
SMTP_FROM=noreply@staging.bodega.example
SMTP_USE_TLS=true

# --- Observability ---
LOG_LEVEL=INFO
SENTRY_DSN=https://CHANGE_ME@sentry.io/123456
METRICS_ENABLED=true

# --- CORS staging ---
CORS_ALLOWED_ORIGINS=https://staging.bodega.example

# --- Approval tokens ---
APPROVAL_TOKEN_MAX_AGE_DAYS=7

# --- Workers ---
WORKER_CONCURRENCY=4
WORKER_MAX_JOBS=10
REPLENISHMENT_EVAL_INTERVAL_SECONDS=300
